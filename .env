# Server Settings
# For local development, uncomment the line below and comment the production URL:
#NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=https://outdoor-spot.com
# you will have to change this if running locally!




# Database Configuration
# For local development with Docker, use: postgresql://postgres:postgres@localhost:5432/outdoor_spot?schema=public
# For production with Docker, use: postgresql://outdoor_spot_user:outdoor_spot_password@postgres:5432/outdoor_spot
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outdoor_spot?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=outdoor_spot

# Authentication
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# External APIs
WEATHER_API_KEY=your_weather_api_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service
EMAIL_SERVICE_API_KEY=your_email_service_api_key
EMAIL_FROM=noreply@outdoorspot.com
EMAIL_FROM_NAME=OutdoorSpot

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Application Settings
NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000
# For local development, uncomment the line below and comment the production URL:
#FRONTEND_URL=http://localhost:3000
FRONTEND_URL=https://outdoor-spot.com
BACKEND_URL=http://outdoor-spot-backend:3001

# Redis Configuration (optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
# For local development, uncomment the line below and comment the production URLs:
#CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN=https://outdoor-spot.com,https://www.outdoor-spot.com

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Development Tools
DEBUG=outdoor-spot:*
MOCK_EXTERNAL_APIS=false